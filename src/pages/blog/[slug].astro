---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdjacentPosts, getBlogPostBySlug } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';

const env = Astro.locals.runtime?.env;
const { slug } = Astro.params;

const post = slug ? await getBlogPostBySlug(env, slug, false) : null;
if (!post) {
  Astro.response.status = 404;
}

const rendered = post ? renderMarkdown(post.content_md) : null;
const adjacent = post && slug ? await getAdjacentPosts(env, slug) : { prev: null, next: null };

function formatDateDot(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso.slice(0, 10).replace(/-/g, '.');
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
  const day = String(d.getUTCDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
}
---

<BaseLayout
  title={post ? `${post.title} — uzit.one` : 'Post Not Found — uzit.one'}
  description={post?.summary || 'Markdown blog post on uzit.one'}
>
  {
    !post || !rendered ? (
      <div class="py-20 text-center space-y-5">
        <p class="font-mono text-base text-light-secondary dark:text-dark-secondary">404 NOT FOUND</p>
        <h1 class="text-2xl font-bold text-light-primary dark:text-dark-primary">
          요청하신 블로그 포스트를 찾을 수 없습니다.
        </h1>
        <div class="pt-3">
          <a
            href="/blog"
            class="font-mono text-sm text-light-accent dark:text-dark-accent hover:underline"
          >
            ← Back to blog
          </a>
        </div>
      </div>
    ) : (
      <article>
        <!-- Post Header -->
        <header class="pb-9 border-b border-light-border dark:border-dark-border">
          <a
            href="/blog"
            class="font-mono text-sm text-light-secondary dark:text-dark-secondary hover:text-light-accent dark:hover:text-dark-accent transition-colors inline-block mb-6"
          >
            ← Back to blog
          </a>

          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-light-primary dark:text-dark-primary leading-snug">
            {post.title}
          </h1>

          {post.summary && (
            <p class="mt-3.5 text-lg sm:text-xl text-light-secondary dark:text-dark-secondary leading-relaxed">
              {post.summary}
            </p>
          )}

          <div class="mt-5 flex flex-wrap items-center gap-3.5 font-mono text-sm text-light-secondary dark:text-dark-secondary">
            <time datetime={post.created_at}>{formatDateDot(post.created_at)}</time>
            {post.updated_at &&
              formatDateDot(post.updated_at) !== formatDateDot(post.created_at) && (
                <span>(Updated {formatDateDot(post.updated_at)})</span>
              )}
            <span>·</span>
            <span>{rendered.readingTimeMinutes} min read</span>
          </div>

          {post.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap items-center gap-2.5">
              {post.tags.map((tag) => (
                <a
                  href={`/blog?tag=${encodeURIComponent(tag)}`}
                  class="font-mono text-sm px-2.5 py-0.5 rounded bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border text-light-secondary dark:text-dark-secondary hover:text-light-accent dark:hover:text-dark-accent transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </header>

        <!-- Table of Contents -->
        {rendered.toc.length > 0 && (
          <details
            open
            class="my-9 p-5 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface"
          >
            <summary class="font-mono text-sm font-bold uppercase tracking-wider text-light-secondary dark:text-dark-secondary cursor-pointer select-none">
              Table of Contents
            </summary>
            <ul class="mt-3.5 space-y-2 text-base">
              {rendered.toc.map((item) => (
                <li
                  style={`padding-left: ${(item.level - 1) * 0.85}rem`}
                  class="text-light-secondary dark:text-dark-secondary"
                >
                  <a
                    href={`#${item.id}`}
                    class="hover:text-light-accent dark:hover:text-dark-accent transition-colors"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <!-- Markdown Body -->
        <div
          id="markdown-content"
          class="py-9 prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-light-accent dark:prose-a:text-dark-accent prose-code:font-mono prose-pre:p-0 prose-pre:bg-transparent"
          set:html={rendered.html}
        />

        <!-- Adjacent Posts Navigation -->
        <nav class="pt-9 mt-9 border-t border-light-border dark:border-dark-border grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            {adjacent.prev && (
              <a
                href={`/blog/${adjacent.prev.slug}`}
                class="block p-5 rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface hover:border-light-accent dark:hover:border-dark-accent transition-colors"
              >
                <span class="font-mono text-sm text-light-secondary dark:text-dark-secondary">
                  ← Previous
                </span>
                <p class="mt-1.5 text-base font-semibold text-light-primary dark:text-dark-primary truncate">
                  {adjacent.prev.title}
                </p>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {adjacent.next && (
              <a
                href={`/blog/${adjacent.next.slug}`}
                class="block p-5 rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface hover:border-light-accent dark:hover:border-dark-accent transition-colors"
              >
                <span class="font-mono text-sm text-light-secondary dark:text-dark-secondary">
                  Next →
                </span>
                <p class="mt-1.5 text-base font-semibold text-light-primary dark:text-dark-primary truncate">
                  {adjacent.next.title}
                </p>
              </a>
            )}
          </div>
        </nav>
      </article>
    )
  }

  <script is:inline>
    (function () {
      document.addEventListener('click', function (e) {
        const target = e.target;
        if (!target || !target.classList || !target.classList.contains('copy-code-btn')) return;
        const wrapper = target.closest('.code-block-wrapper');
        if (!wrapper) return;
        const codeEl = wrapper.querySelector('code');
        if (!codeEl) return;
        const text = codeEl.textContent || '';
        navigator.clipboard.writeText(text).then(function () {
          const prev = target.textContent;
          target.textContent = 'Copied';
          setTimeout(function () {
            target.textContent = prev || 'Copy';
          }, 1500);
        });
      });
    })();
  </script>
</BaseLayout>

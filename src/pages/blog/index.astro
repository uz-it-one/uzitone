---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/db';
import { formatDateDot } from '../../lib/github';
import { calculateReadingTime } from '../../lib/markdown';

const env = Astro.locals.runtime?.env;
const url = Astro.url;
const activeTag = url.searchParams.get('tag') || 'All';
const searchQuery = url.searchParams.get('search') || '';

const allPublished = await getBlogPosts(env, { includeDrafts: false });
const allTags = ['All', ...new Set(allPublished.flatMap((post) => post.tags))];

const postsWithMeta = allPublished.map((post) => ({
  ...post,
  readingTime: calculateReadingTime(post.content_md),
}));
---

<BaseLayout
  title="Blog — uzit.one"
  description="Markdown technical articles and personal essays by Uz_it_one."
>
  <section class="pb-10 border-b border-light-border dark:border-dark-border">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-light-primary dark:text-dark-primary">
      Blog
    </h1>
    <p class="text-base sm:text-lg text-light-secondary dark:text-dark-secondary mt-2.5">
      개발 기록, 프로젝트 회고, 그리고 개인적인 생각을 마크다운으로 기록합니다.
    </p>

    <!-- Search Input & Tag Filter Chips -->
    <div class="mt-7 space-y-4">
      <div>
        <input
          id="blog-search-input"
          type="search"
          value={searchQuery}
          placeholder="제목, 요약, 태그 검색..."
          class="w-full px-4 py-2.5 text-base rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-primary dark:text-dark-primary placeholder:text-light-secondary/70 dark:placeholder:text-dark-secondary/70 focus:outline-none focus:border-light-accent dark:focus:border-dark-accent transition-colors"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2.5" id="blog-tag-filters">
        {
          allTags.map((tag) => {
            const isSelected = activeTag.toLowerCase() === tag.toLowerCase();
            return (
              <button
                type="button"
                data-tag={tag}
                class={`tag-filter-btn font-mono text-sm px-3.5 py-1.5 rounded border transition-colors ${
                  isSelected
                    ? 'border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent bg-light-accent/5 dark:bg-dark-accent/10 font-semibold'
                    : 'border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary'
                }`}
              >
                {tag === 'All' ? 'All' : `#${tag}`}
              </button>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Blog Posts List -->
  <section class="pt-10">
    <div id="blog-posts-container" class="divide-y divide-light-border/70 dark:divide-dark-border/70">
      {
        postsWithMeta.map((post) => (
          <article
            class="blog-post-item py-7 first:pt-0 last:pb-0 group"
            data-title={post.title.toLowerCase()}
            data-summary={(post.summary || '').toLowerCase()}
            data-tags={post.tags.map((t) => t.toLowerCase()).join(',')}
          >
            <div class="flex items-center gap-3 font-mono text-sm text-light-secondary dark:text-dark-secondary">
              <time datetime={post.created_at}>{formatDateDot(post.created_at)}</time>
              <span>·</span>
              <span>{post.readingTime} min read</span>
            </div>

            <h2 class="mt-2 text-xl sm:text-2xl font-bold tracking-tight text-light-primary dark:text-dark-primary group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">
              <a href={`/blog/${post.slug}`} class="block">
                {post.title}
              </a>
            </h2>

            {post.summary && (
              <p class="mt-2.5 text-base sm:text-lg text-light-secondary dark:text-dark-secondary leading-relaxed">
                {post.summary}
              </p>
            )}

            {post.tags.length > 0 && (
              <div class="mt-3.5 flex flex-wrap items-center gap-2">
                {post.tags.map((tag) => (
                  <span class="font-mono text-sm px-2.5 py-0.5 rounded bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border text-light-secondary dark:text-dark-secondary">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <p
      id="blog-empty-message"
      class="hidden text-base text-light-secondary dark:text-dark-secondary py-10 text-center"
    >
      작성된 블로그 게시물이 없습니다.
    </p>
  </section>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById('blog-search-input');
      const tagButtons = document.querySelectorAll('.tag-filter-btn');
      const postItems = document.querySelectorAll('.blog-post-item');
      const emptyMsg = document.getElementById('blog-empty-message');

      const ACTIVE_TAG_CLASS =
        'tag-filter-btn font-mono text-sm px-3.5 py-1.5 rounded border transition-colors border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent bg-light-accent/5 dark:bg-dark-accent/10 font-semibold';
      const INACTIVE_TAG_CLASS =
        'tag-filter-btn font-mono text-sm px-3.5 py-1.5 rounded border transition-colors border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary';

      const initialParams = new URLSearchParams(window.location.search);
      let currentTag = initialParams.get('tag') || 'All';

      function applyFilter() {
        const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
        const selectedTag = currentTag.toLowerCase();
        let visibleCount = 0;

        postItems.forEach((item) => {
          const title = item.getAttribute('data-title') || '';
          const summary = item.getAttribute('data-summary') || '';
          const tags = (item.getAttribute('data-tags') || '').split(',').filter(Boolean);

          const matchesTag = selectedTag === 'all' || tags.includes(selectedTag);
          const matchesQuery =
            !query ||
            title.includes(query) ||
            summary.includes(query) ||
            tags.some((tag) => tag.includes(query));

          const isVisible = matchesTag && matchesQuery;
          item.classList.toggle('hidden', !isVisible);
          if (isVisible) visibleCount++;
        });

        if (emptyMsg) {
          emptyMsg.classList.toggle('hidden', visibleCount > 0);
        }
      }

      tagButtons.forEach((button) => {
        button.addEventListener('click', () => {
          currentTag = button.getAttribute('data-tag') || 'All';
          tagButtons.forEach((candidate) => {
            const candidateTag = (candidate.getAttribute('data-tag') || '').toLowerCase();
            const isSelected = candidateTag === currentTag.toLowerCase();
            candidate.className = isSelected ? ACTIVE_TAG_CLASS : INACTIVE_TAG_CLASS;
          });
          applyFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyFilter);
      }

      applyFilter();
    })();
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts } from '../../lib/db';
import { calculateReadingTime } from '../../lib/markdown';

const env = Astro.locals.runtime?.env;
const url = Astro.url;
const activeTag = url.searchParams.get('tag') || 'All';
const searchQuery = url.searchParams.get('search') || '';

const allPublished = await getBlogPosts(env, { includeDrafts: false });

// Extract unique tags across all published posts
const tagSet = new Set<string>();
for (const post of allPublished) {
  for (const t of post.tags) {
    tagSet.add(t);
  }
}
const allTags = ['All', ...Array.from(tagSet)];

const postsWithMeta = allPublished.map((post) => ({
  ...post,
  readingTime: calculateReadingTime(post.content_md),
}));

function formatDateDot(iso: string): string {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso.slice(0, 10).replace(/-/g, '.');
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, '0');
  const day = String(d.getUTCDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
}
---

<BaseLayout
  title="Blog — uzit.one"
  description="Markdown technical articles and personal essays by Uz_it_one."
>
  <section class="pb-8 border-b border-light-border dark:border-dark-border">
    <h1 class="text-2xl font-bold tracking-tight text-light-primary dark:text-dark-primary">
      Blog
    </h1>
    <p class="text-sm text-light-secondary dark:text-dark-secondary mt-2">
      개발 기록, 프로젝트 회고, 그리고 개인적인 생각을 마크다운으로 기록합니다.
    </p>

    <!-- Search Input & Tag Filter Chips -->
    <div class="mt-6 space-y-4">
      <div>
        <input
          id="blog-search-input"
          type="search"
          value={searchQuery}
          placeholder="제목, 요약, 태그 검색..."
          class="w-full px-3.5 py-2 text-sm rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-primary dark:text-dark-primary placeholder:text-light-secondary/70 dark:placeholder:text-dark-secondary/70 focus:outline-none focus:border-light-accent dark:focus:border-dark-accent transition-colors"
        />
      </div>

      <div class="flex flex-wrap items-center gap-2" id="blog-tag-filters">
        {
          allTags.map((tag) => {
            const isSelected = activeTag.toLowerCase() === tag.toLowerCase();
            return (
              <button
                type="button"
                data-tag={tag}
                class={`tag-filter-btn font-mono text-xs px-2.5 py-1 rounded border transition-colors ${
                  isSelected
                    ? 'border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent bg-light-accent/5 dark:bg-dark-accent/10 font-medium'
                    : 'border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary'
                }`}
              >
                {tag === 'All' ? 'All' : `#${tag}`}
              </button>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Blog Posts List -->
  <section class="pt-8">
    <div id="blog-posts-container" class="divide-y divide-light-border/70 dark:divide-dark-border/70">
      {
        postsWithMeta.map((post) => (
          <article
            class="blog-post-item py-6 first:pt-0 last:pb-0 group"
            data-title={post.title.toLowerCase()}
            data-summary={(post.summary || '').toLowerCase()}
            data-tags={post.tags.map((t) => t.toLowerCase()).join(',')}
          >
            <div class="flex items-center gap-3 font-mono text-xs text-light-secondary dark:text-dark-secondary">
              <time datetime={post.created_at}>{formatDateDot(post.created_at)}</time>
              <span>·</span>
              <span>{post.readingTime} min read</span>
            </div>

            <h2 class="mt-1.5 text-lg font-semibold tracking-tight text-light-primary dark:text-dark-primary group-hover:text-light-accent dark:group-hover:text-dark-accent transition-colors">
              <a href={`/blog/${post.slug}`} class="block">
                {post.title}
              </a>
            </h2>

            {post.summary && (
              <p class="mt-2 text-sm text-light-secondary dark:text-dark-secondary leading-relaxed">
                {post.summary}
              </p>
            )}

            {post.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-2">
                {post.tags.map((tag) => (
                  <span class="font-mono text-xs px-2 py-0.5 rounded bg-light-surface dark:bg-dark-surface border border-light-border dark:border-dark-border text-light-secondary dark:text-dark-secondary">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <p
      id="blog-empty-message"
      class="hidden text-sm text-light-secondary dark:text-dark-secondary py-8 text-center"
    >
      조건에 일치하는 포스트가 없습니다.
    </p>
  </section>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById('blog-search-input');
      const tagButtons = document.querySelectorAll('.tag-filter-btn');
      const postItems = document.querySelectorAll('.blog-post-item');
      const emptyMsg = document.getElementById('blog-empty-message');

      let currentTag = 'All';
      const initialParams = new URLSearchParams(window.location.search);
      if (initialParams.get('tag')) {
        currentTag = initialParams.get('tag');
      }

      function applyFilter() {
        const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
        const tagLower = currentTag.toLowerCase();
        let visibleCount = 0;

        postItems.forEach((item) => {
          const title = item.getAttribute('data-title') || '';
          const summary = item.getAttribute('data-summary') || '';
          const tags = (item.getAttribute('data-tags') || '').split(',').filter(Boolean);

          const matchesTag = tagLower === 'all' || tags.includes(tagLower);
          const matchesQuery =
            !query ||
            title.includes(query) ||
            summary.includes(query) ||
            tags.some((t) => t.includes(query));

          if (matchesTag && matchesQuery) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (emptyMsg) {
          if (visibleCount === 0) {
            emptyMsg.classList.remove('hidden');
          } else {
            emptyMsg.classList.add('hidden');
          }
        }
      }

      tagButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentTag = btn.getAttribute('data-tag') || 'All';
          tagButtons.forEach((b) => {
            const isSel =
              (b.getAttribute('data-tag') || '').toLowerCase() === currentTag.toLowerCase();
            if (isSel) {
              b.className =
                'tag-filter-btn font-mono text-xs px-2.5 py-1 rounded border transition-colors border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent bg-light-accent/5 dark:bg-dark-accent/10 font-medium';
            } else {
              b.className =
                'tag-filter-btn font-mono text-xs px-2.5 py-1 rounded border transition-colors border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary';
            }
          });
          applyFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyFilter);
      }

      applyFilter();
    })();
  </script>
</BaseLayout>

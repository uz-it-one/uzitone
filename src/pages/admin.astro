---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isAuthenticatedRequest } from '../lib/auth';

const env = Astro.locals.runtime?.env;
const isAuthed = await isAuthenticatedRequest(Astro.request, env);
---

<BaseLayout
  title="Admin — uzit.one"
  description="Private management console for uzit.one"
  maxWidthClass="max-w-[1140px]"
>
  {
    !isAuthed ? (
      <!-- Admin Login View -->
      <section class="max-w-md mx-auto py-16">
        <div class="p-7 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface space-y-6">
          <div>
            <h1 class="font-mono text-xl font-bold text-light-primary dark:text-dark-primary">
              /admin Authentication
            </h1>
            <p class="text-sm text-light-secondary dark:text-dark-secondary mt-1.5">
              프로젝트 선택 및 마크다운 블로그 관리를 위해 관리자 비밀번호를 입력하세요.
            </p>
          </div>

          <form id="admin-login-form" class="space-y-4">
            <div>
              <label
                for="admin-password"
                class="block font-mono text-sm text-light-secondary dark:text-dark-secondary mb-1.5"
              >
                Password
              </label>
              <input
                id="admin-password"
                name="password"
                type="password"
                required
                placeholder="Enter ADMIN_PASSWORD"
                class="w-full px-3.5 py-2.5 text-base rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary focus:outline-none focus:border-light-accent dark:focus:border-dark-accent"
              />
            </div>

            <p id="login-error-msg" class="hidden text-sm text-red-600 dark:text-red-400" />

            <button
              type="submit"
              class="w-full py-2.5 px-4 rounded font-mono text-sm font-semibold bg-light-accent dark:bg-dark-accent text-white dark:text-dark-base hover:opacity-90 transition-opacity"
            >
              Sign In
            </button>
          </form>
        </div>
      </section>
    ) : (
      <!-- Authenticated Admin Dashboard -->
      <div class="space-y-9">
        <!-- Admin Top Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-light-border dark:border-dark-border">
          <div>
            <h1 class="font-mono text-2xl font-bold text-light-primary dark:text-dark-primary">
              Admin Console
            </h1>
            <p class="text-sm text-light-secondary dark:text-dark-secondary mt-1">
              GitHub 레포지토리 선별 및 마크다운 블로그 에디터
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <button
              type="button"
              id="tab-btn-projects"
              class="font-mono text-sm px-4 py-2 rounded border border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent bg-light-accent/5 dark:bg-dark-accent/10 font-semibold"
            >
              1. Projects Manager
            </button>
            <button
              type="button"
              id="tab-btn-blog"
              class="font-mono text-sm px-4 py-2 rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary"
            >
              2. Blog Editor
            </button>
            <button
              type="button"
              id="admin-logout-btn"
              class="font-mono text-sm px-3.5 py-2 rounded border border-light-border dark:border-dark-border text-light-secondary dark:text-dark-secondary hover:text-red-600 dark:hover:text-red-400 ml-1"
            >
              Logout
            </button>
          </div>
        </div>

        <!-- TAB 1: GitHub Projects Curation Manager -->
        <section id="panel-projects" class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-light-primary dark:text-dark-primary">
                진행 중인 프로젝트 선택 (GitHub Public Repositories)
              </h2>
              <p class="text-sm text-light-secondary dark:text-dark-secondary mt-1">
                본인 소유(uz-it-one) Public 레포지토리만 불러옵니다(Organization 레포 자동 제외). 체크박스로 메인 페이지 노출 여부를 선택하세요.
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <label class="inline-flex items-center gap-2 text-sm font-mono text-light-secondary dark:text-dark-secondary cursor-pointer">
                <input
                  type="checkbox"
                  id="toggle-show-forks"
                  checked
                  class="w-4 h-4 rounded border-light-border dark:border-dark-border"
                />
                <span>Include Forks</span>
              </label>

              <button
                type="button"
                id="refresh-repos-btn"
                class="font-mono text-sm px-3.5 py-2 rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface hover:border-light-accent dark:hover:border-dark-accent transition-colors"
              >
                Refresh GitHub
              </button>

              <button
                type="button"
                id="save-projects-btn"
                class="font-mono text-sm px-4 py-2 rounded bg-light-accent dark:bg-dark-accent text-white dark:text-dark-base font-semibold hover:opacity-90 transition-opacity"
              >
                Save Selection
              </button>
            </div>
          </div>

          <p id="projects-status-msg" class="hidden font-mono text-sm" />

          <div
            id="repos-list-container"
            class="divide-y divide-light-border dark:divide-dark-border rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface"
          >
            <div class="p-6 text-base text-light-secondary dark:text-dark-secondary font-mono">
              Loading GitHub repositories...
            </div>
          </div>
        </section>

        <!-- TAB 2: Markdown Blog Editor -->
        <section id="panel-blog" class="hidden space-y-9">
          <!-- Existing Posts List -->
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <h2 class="text-lg font-bold text-light-primary dark:text-dark-primary">
                저장된 블로그 포스트
              </h2>
              <button
                type="button"
                id="new-post-btn"
                class="font-mono text-sm px-3.5 py-2 rounded border border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent hover:bg-light-accent/5 dark:hover:bg-dark-accent/10 font-semibold"
              >
                + New Post
              </button>
            </div>

            <div
              id="admin-posts-list"
              class="divide-y divide-light-border dark:divide-dark-border rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface"
            >
              <div class="p-5 text-sm font-mono text-light-secondary dark:text-dark-secondary">
                Loading posts...
              </div>
            </div>
          </div>

          <!-- Post Editor Form -->
          <form
            id="blog-editor-form"
            class="p-7 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface space-y-6"
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-light-border dark:border-dark-border pb-4">
              <h3
                id="editor-form-heading"
                class="font-mono text-base font-bold text-light-primary dark:text-dark-primary"
              >
                새 블로그 포스트 작성
              </h3>
              <input type="hidden" id="post-id" value="" />
              <label class="inline-flex items-center gap-2 font-mono text-sm text-light-secondary dark:text-dark-secondary cursor-pointer">
                <input type="checkbox" id="post-published" checked class="w-4 h-4" />
                <span>Published (체크 해제 시 Draft 임시저장)</span>
              </label>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label
                  for="post-title"
                  class="block font-mono text-sm text-light-secondary dark:text-dark-secondary mb-1.5"
                >
                  Title *
                </label>
                <input
                  id="post-title"
                  type="text"
                  required
                  placeholder="포스트 제목을 입력하세요"
                  class="w-full px-3.5 py-2.5 text-base rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary focus:outline-none focus:border-light-accent dark:focus:border-dark-accent"
                />
              </div>

              <div>
                <label
                  for="post-slug"
                  class="block font-mono text-sm text-light-secondary dark:text-dark-secondary mb-1.5"
                >
                  Slug (/blog/[slug])
                </label>
                <input
                  id="post-slug"
                  type="text"
                  placeholder="url-slug-example"
                  class="w-full px-3.5 py-2.5 text-base font-mono rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary focus:outline-none focus:border-light-accent dark:focus:border-dark-accent"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label
                  for="post-summary"
                  class="block font-mono text-sm text-light-secondary dark:text-dark-secondary mb-1.5"
                >
                  Summary (한 줄 요약)
                </label>
                <input
                  id="post-summary"
                  type="text"
                  placeholder="목록에 표시될 요약 설명"
                  class="w-full px-3.5 py-2.5 text-base rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary focus:outline-none focus:border-light-accent dark:focus:border-dark-accent"
                />
              </div>

              <div>
                <label
                  for="post-tags"
                  class="block font-mono text-sm text-light-secondary dark:text-dark-secondary mb-1.5"
                >
                  Tags (쉼표 구분)
                </label>
                <input
                  id="post-tags"
                  type="text"
                  placeholder="Swift, macOS, Essay"
                  class="w-full px-3.5 py-2.5 text-base font-mono rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary focus:outline-none focus:border-light-accent dark:focus:border-dark-accent"
                />
              </div>
            </div>

            <!-- Markdown Toolbar -->
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <button
                type="button"
                data-md-insert="## "
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                H2
              </button>
              <button
                type="button"
                data-md-insert="### "
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                H3
              </button>
              <button
                type="button"
                data-md-wrap="**"
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                Bold
              </button>
              <button
                type="button"
                data-md-wrap="*"
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                Italic
              </button>
              <button
                type="button"
                data-md-wrap="`"
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                Code
              </button>
              <button
                type="button"
                data-md-block="```typescript\n// code\n```\n"
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                Code Block
              </button>
              <button
                type="button"
                data-md-insert="> "
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                Quote
              </button>
              <button
                type="button"
                data-md-insert="- "
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                List
              </button>
              <button
                type="button"
                data-md-block="[링크 텍스트](https://)"
                class="md-tool-btn font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base hover:border-light-accent dark:hover:border-dark-accent"
              >
                Link
              </button>
            </div>

            <!-- Split View: Markdown Input & Real-time Preview -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
              <div>
                <div class="font-mono text-sm text-light-secondary dark:text-dark-secondary mb-2">
                  Markdown Source *
                </div>
                <textarea
                  id="post-content-md"
                  rows="16"
                  required
                  placeholder="마크다운으로 본문을 작성하세요..."
                  class="w-full p-4 text-base font-mono leading-relaxed rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary focus:outline-none focus:border-light-accent dark:focus:border-dark-accent resize-y"
                />
              </div>

              <div>
                <div class="font-mono text-sm text-light-secondary dark:text-dark-secondary mb-2">
                  Live Preview
                </div>
                <div
                  id="markdown-live-preview"
                  class="h-[430px] overflow-y-auto p-5 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base prose prose-base prose-slate dark:prose-invert max-w-none"
                >
                  <p class="text-sm font-mono text-light-secondary dark:text-dark-secondary">
                    좌측에 마크다운을 입력하면 실시간 프리뷰가 표시됩니다.
                  </p>
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <p id="blog-save-status" class="font-mono text-sm" />
              <button
                type="submit"
                class="font-mono text-sm px-5 py-2.5 rounded bg-light-accent dark:bg-dark-accent text-white dark:text-dark-base font-semibold hover:opacity-90 transition-opacity"
              >
                Save Post
              </button>
            </div>
          </form>
        </section>

        <!-- Confirmation & Alert Modal Popup -->
        <div
          id="admin-modal-backdrop"
          class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 px-4"
          role="dialog"
          aria-modal="true"
        >
          <div class="w-full max-w-md rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface p-6 shadow-xl space-y-5">
            <div class="space-y-2">
              <h3
                id="admin-modal-title"
                class="font-mono text-lg font-bold text-light-primary dark:text-dark-primary"
              >
                확인
              </h3>
              <p
                id="admin-modal-message"
                class="text-base text-light-secondary dark:text-dark-secondary leading-relaxed"
              />
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
              <button
                type="button"
                id="admin-modal-cancel-btn"
                class="font-mono text-sm px-4 py-2 rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary"
              >
                취소
              </button>
              <button
                type="button"
                id="admin-modal-confirm-btn"
                class="font-mono text-sm px-4 py-2 rounded bg-light-accent dark:bg-dark-accent text-white dark:text-dark-base font-semibold hover:opacity-90"
              >
                확인
              </button>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <script is:inline>
    (function () {
      /* -------------------------------------------------------------------- */
      /* DOM & UI Helpers                                                     */
      /* -------------------------------------------------------------------- */
      function createEl(tag, className, textContent) {
        const element = document.createElement(tag);
        if (className) element.className = className;
        if (textContent !== undefined) element.textContent = textContent;
        return element;
      }

      /* -------------------------------------------------------------------- */
      /* 1. Login Form Handler                                                */
      /* -------------------------------------------------------------------- */
      const loginForm = document.getElementById('admin-login-form');
      if (loginForm) {
        loginForm.addEventListener('submit', async function (event) {
          event.preventDefault();
          const passwordInput = document.getElementById('admin-password');
          const errorMsg = document.getElementById('login-error-msg');
          if (!passwordInput) return;

          const response = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: passwordInput.value }),
          });

          if (response.ok) {
            window.location.reload();
            return;
          }

          const data = await response.json().catch(() => ({}));
          if (errorMsg) {
            errorMsg.textContent = data.error || '로그인에 실패했습니다.';
            errorMsg.classList.remove('hidden');
          }
        });
        return;
      }

      /* -------------------------------------------------------------------- */
      /* 2. Confirmation & Alert Modal Popups                                 */
      /* -------------------------------------------------------------------- */
      const modalBackdrop = document.getElementById('admin-modal-backdrop');
      const modalTitle = document.getElementById('admin-modal-title');
      const modalMessage = document.getElementById('admin-modal-message');
      const modalCancelBtn = document.getElementById('admin-modal-cancel-btn');
      const modalConfirmBtn = document.getElementById('admin-modal-confirm-btn');

      const DANGER_BTN_CLASS =
        'font-mono text-sm px-4 py-2 rounded bg-red-600 text-white font-semibold hover:bg-red-700';
      const PRIMARY_BTN_CLASS =
        'font-mono text-sm px-4 py-2 rounded bg-light-accent dark:bg-dark-accent text-white dark:text-dark-base font-semibold hover:opacity-90';

      function openModal({
        title,
        message,
        confirmText = '확인',
        cancelText = '취소',
        isDanger = false,
        showCancel = true,
      }) {
        return new Promise((resolve) => {
          if (!modalBackdrop || !modalTitle || !modalMessage || !modalCancelBtn || !modalConfirmBtn) {
            resolve(showCancel ? window.confirm(message) : (window.alert(message), true));
            return;
          }

          modalTitle.textContent = title || '확인';
          modalMessage.textContent = message || '';
          modalConfirmBtn.textContent = confirmText;
          modalCancelBtn.textContent = cancelText;
          modalCancelBtn.classList.toggle('hidden', !showCancel);
          modalConfirmBtn.className = isDanger ? DANGER_BTN_CLASS : PRIMARY_BTN_CLASS;
          modalBackdrop.classList.remove('hidden');

          function closeWithResult(result) {
            modalBackdrop.classList.add('hidden');
            modalConfirmBtn.removeEventListener('click', onConfirm);
            modalCancelBtn.removeEventListener('click', onCancel);
            resolve(result);
          }

          function onConfirm() {
            closeWithResult(true);
          }
          function onCancel() {
            closeWithResult(false);
          }

          modalConfirmBtn.addEventListener('click', onConfirm);
          modalCancelBtn.addEventListener('click', onCancel);
        });
      }

      function showConfirmPopup(title, message, options = {}) {
        return openModal({
          title,
          message,
          confirmText: options.confirmText || '확인',
          cancelText: options.cancelText || '취소',
          isDanger: Boolean(options.isDanger),
          showCancel: true,
        });
      }

      function showAlertPopup(title, message) {
        return openModal({
          title,
          message,
          confirmText: '확인',
          showCancel: false,
        });
      }

      /* -------------------------------------------------------------------- */
      /* 3. Dashboard Tab Navigation & Logout                                 */
      /* -------------------------------------------------------------------- */
      const tabBtnProjects = document.getElementById('tab-btn-projects');
      const tabBtnBlog = document.getElementById('tab-btn-blog');
      const panelProjects = document.getElementById('panel-projects');
      const panelBlog = document.getElementById('panel-blog');
      const logoutBtn = document.getElementById('admin-logout-btn');

      const ACTIVE_TAB_CLASS =
        'font-mono text-sm px-4 py-2 rounded border border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent bg-light-accent/5 dark:bg-dark-accent/10 font-semibold';
      const INACTIVE_TAB_CLASS =
        'font-mono text-sm px-4 py-2 rounded border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface text-light-secondary dark:text-dark-secondary hover:text-light-primary dark:hover:text-dark-primary';

      function switchActiveTab(activeTab) {
        if (!tabBtnProjects || !tabBtnBlog || !panelProjects || !panelBlog) return;
        const isProjectsTab = activeTab === 'projects';
        tabBtnProjects.className = isProjectsTab ? ACTIVE_TAB_CLASS : INACTIVE_TAB_CLASS;
        tabBtnBlog.className = isProjectsTab ? INACTIVE_TAB_CLASS : ACTIVE_TAB_CLASS;
        panelProjects.classList.toggle('hidden', !isProjectsTab);
        panelBlog.classList.toggle('hidden', isProjectsTab);
      }

      if (tabBtnProjects && tabBtnBlog) {
        tabBtnProjects.addEventListener('click', () => switchActiveTab('projects'));
        tabBtnBlog.addEventListener('click', () => switchActiveTab('blog'));
      }

      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          await fetch('/api/admin/login', { method: 'DELETE' });
          window.location.reload();
        });
      }

      /* -------------------------------------------------------------------- */
      /* 4. Projects Manager Logic                                            */
      /* -------------------------------------------------------------------- */
      let reposState = [];
      const reposContainer = document.getElementById('repos-list-container');
      const toggleShowForks = document.getElementById('toggle-show-forks');
      const refreshReposBtn = document.getElementById('refresh-repos-btn');
      const saveProjectsBtn = document.getElementById('save-projects-btn');
      const projectsStatusMsg = document.getElementById('projects-status-msg');

      const BADGE_CLASS =
        'font-mono text-xs px-2 py-0.5 rounded border border-light-border dark:border-dark-border text-light-secondary dark:text-dark-secondary';
      const ORDER_BTN_CLASS =
        'font-mono text-xs px-2.5 py-1 rounded border border-light-border dark:border-dark-border disabled:opacity-40';

      function showProjectsStatus(text, isError) {
        if (!projectsStatusMsg) return;
        projectsStatusMsg.textContent = text;
        projectsStatusMsg.className = isError
          ? 'font-mono text-sm text-red-600 dark:text-red-400'
          : 'font-mono text-sm text-light-accent dark:text-dark-accent';
      }

      function moveRepoInState(repo, directionOffset) {
        const currentIndex = reposState.indexOf(repo);
        const targetIndex = currentIndex + directionOffset;
        if (currentIndex < 0 || targetIndex < 0 || targetIndex >= reposState.length) return;

        const targetRepo = reposState[targetIndex];
        reposState[targetIndex] = repo;
        reposState[currentIndex] = targetRepo;
        renderReposList();
      }

      function createRepoConfigFields(repo) {
        const configLine = createEl('div', 'pl-8 grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1');

        const statusInput = createEl(
          'input',
          'px-3 py-2 text-sm font-mono rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary'
        );
        statusInput.type = 'text';
        statusInput.value = repo.status_label || '진행 중';
        statusInput.placeholder = '상태 라벨 (예: 진행 중)';
        statusInput.addEventListener('input', () => {
          repo.status_label = statusInput.value;
        });

        const customDescInput = createEl(
          'input',
          'sm:col-span-2 px-3 py-2 text-sm rounded border border-light-border dark:border-dark-border bg-light-base dark:bg-dark-base text-light-primary dark:text-dark-primary'
        );
        customDescInput.type = 'text';
        customDescInput.value = repo.custom_description || '';
        customDescInput.placeholder =
          '커스텀 설명 (비워두면 GitHub 기본 설명이 메인 페이지에 표시됩니다)';
        customDescInput.addEventListener('input', () => {
          repo.custom_description = customDescInput.value;
        });

        configLine.append(statusInput, customDescInput);
        return configLine;
      }

      function createRepoRowElement(repo, visibleIndex, totalVisible) {
        const row = createEl('div', 'p-5 flex flex-col gap-3.5');
        const topLine = createEl('div', 'flex items-start justify-between gap-4');
        const leftLabel = createEl('label', 'flex items-start gap-3.5 cursor-pointer flex-1');

        const checkbox = createEl(
          'input',
          'mt-1.5 w-4 h-4 rounded border-light-border dark:border-dark-border'
        );
        checkbox.type = 'checkbox';
        checkbox.checked = Boolean(repo.selected);
        checkbox.addEventListener('change', () => {
          repo.selected = checkbox.checked;
          renderReposList();
        });

        const titleLine = createEl('div', 'flex flex-wrap items-center gap-2.5');
        titleLine.appendChild(
          createEl(
            'span',
            'font-mono text-base font-bold text-light-primary dark:text-dark-primary',
            repo.name
          )
        );
        if (repo.language) {
          titleLine.appendChild(createEl('span', BADGE_CLASS, repo.language));
        }
        if (repo.fork) {
          titleLine.appendChild(createEl('span', BADGE_CLASS, 'Fork'));
        }

        const descriptionEl = createEl(
          'p',
          'text-sm text-light-secondary dark:text-dark-secondary',
          repo.description || '(GitHub 설명 없음)'
        );

        const infoDiv = createEl('div', 'space-y-1');
        infoDiv.append(titleLine, descriptionEl);
        leftLabel.append(checkbox, infoDiv);

        const upBtn = createEl('button', ORDER_BTN_CLASS, 'Up');
        upBtn.type = 'button';
        upBtn.disabled = visibleIndex === 0;
        upBtn.addEventListener('click', () => moveRepoInState(repo, -1));

        const downBtn = createEl('button', ORDER_BTN_CLASS, 'Down');
        downBtn.type = 'button';
        downBtn.disabled = visibleIndex === totalVisible - 1;
        downBtn.addEventListener('click', () => moveRepoInState(repo, 1));

        const rightControls = createEl('div', 'flex items-center gap-2 shrink-0');
        rightControls.append(upBtn, downBtn);

        topLine.append(leftLabel, rightControls);
        row.appendChild(topLine);

        if (repo.selected) {
          row.appendChild(createRepoConfigFields(repo));
        }

        return row;
      }

      function renderReposList() {
        if (!reposContainer) return;
        const showForks = toggleShowForks ? toggleShowForks.checked : true;
        const visibleRepos = reposState.filter((repo) => showForks || !repo.fork || repo.selected);

        if (visibleRepos.length === 0) {
          reposContainer.innerHTML =
            '<div class="p-6 text-base text-light-secondary dark:text-dark-secondary font-mono">표시할 레포지토리가 없습니다.</div>';
          return;
        }

        reposContainer.innerHTML = '';
        visibleRepos.forEach((repo, visibleIndex) => {
          reposContainer.appendChild(
            createRepoRowElement(repo, visibleIndex, visibleRepos.length)
          );
        });
      }

      async function loadGitHubRepos(forceRefresh) {
        const query = forceRefresh ? '?refresh=1' : '';
        const response = await fetch(`/api/admin/github-repos${query}`);
        if (!response.ok) {
          showProjectsStatus('레포지토리 목록을 불러오지 못했습니다.', true);
          return;
        }
        const data = await response.json();
        reposState = Array.isArray(data.repos) ? data.repos : [];
        renderReposList();
      }

      if (toggleShowForks) {
        toggleShowForks.addEventListener('change', renderReposList);
      }

      if (refreshReposBtn) {
        refreshReposBtn.addEventListener('click', async () => {
          showProjectsStatus('GitHub에서 최신 레포지토리 목록을 동기화하는 중...', false);
          await loadGitHubRepos(true);
          showProjectsStatus('최신 GitHub 레포지토리 목록을 불러왔습니다.', false);
        });
      }

      if (saveProjectsBtn) {
        saveProjectsBtn.addEventListener('click', async () => {
          const selectedPayload = reposState
            .filter((repo) => repo.selected)
            .map((repo, index) => ({
              repo_name: repo.name,
              display_order: index + 1,
              status_label: repo.status_label || '진행 중',
              custom_description: repo.custom_description || null,
            }));

          const confirmed = await showConfirmPopup(
            '프로젝트 설정 저장',
            `선택한 ${selectedPayload.length}개의 프로젝트 노출 설정을 저장하시겠습니까?`,
            { confirmText: '저장' }
          );
          if (!confirmed) return;

          const response = await fetch('/api/admin/projects', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projects: selectedPayload }),
          });

          if (response.ok) {
            showProjectsStatus(
              `저장 완료! 메인 페이지에 ${selectedPayload.length}개의 프로젝트가 노출됩니다.`,
              false
            );
            await showAlertPopup(
              '저장 완료',
              `프로젝트 설정이 저장되었습니다. (메인 페이지 노출: ${selectedPayload.length}개)`
            );
          } else {
            showProjectsStatus('저장 중 오류가 발생했습니다.', true);
            await showAlertPopup('오류', '프로젝트 설정 저장 중 오류가 발생했습니다.');
          }
        });
      }

      /* -------------------------------------------------------------------- */
      /* 5. Markdown Blog Editor Logic                                        */
      /* -------------------------------------------------------------------- */
      let adminPosts = [];
      const adminPostsList = document.getElementById('admin-posts-list');
      const newPostBtn = document.getElementById('new-post-btn');
      const blogForm = document.getElementById('blog-editor-form');
      const formHeading = document.getElementById('editor-form-heading');
      const postIdInput = document.getElementById('post-id');
      const postTitleInput = document.getElementById('post-title');
      const postSlugInput = document.getElementById('post-slug');
      const postSummaryInput = document.getElementById('post-summary');
      const postTagsInput = document.getElementById('post-tags');
      const postPublishedInput = document.getElementById('post-published');
      const postContentInput = document.getElementById('post-content-md');
      const livePreview = document.getElementById('markdown-live-preview');
      const blogSaveStatus = document.getElementById('blog-save-status');

      let slugManuallyEdited = false;

      function autoSlugify(text) {
        return text
          .toLowerCase()
          .trim()
          .replace(/[^\w\s가-힣-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
      }

      if (postSlugInput) {
        postSlugInput.addEventListener('input', () => {
          slugManuallyEdited = postSlugInput.value.trim().length > 0;
        });
      }

      if (postTitleInput && postSlugInput) {
        postTitleInput.addEventListener('input', () => {
          const isCreatingNew = !postIdInput || !postIdInput.value;
          if (!slugManuallyEdited && isCreatingNew) {
            postSlugInput.value = autoSlugify(postTitleInput.value);
          }
        });
      }

      let previewTimer = null;
      async function updateLivePreview() {
        if (!postContentInput || !livePreview) return;
        const markdown = postContentInput.value;
        if (!markdown.trim()) {
          livePreview.innerHTML =
            '<p class="text-sm font-mono text-light-secondary dark:text-dark-secondary">좌측에 마크다운을 입력하면 실시간 프리뷰가 표시됩니다.</p>';
          return;
        }
        const response = await fetch('/api/admin/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content_md: markdown }),
        });
        if (response.ok) {
          const data = await response.json();
          livePreview.innerHTML = data.html || '';
        }
      }

      if (postContentInput) {
        postContentInput.addEventListener('input', () => {
          if (previewTimer) clearTimeout(previewTimer);
          previewTimer = setTimeout(updateLivePreview, 180);
        });
      }

      document.querySelectorAll('.md-tool-btn').forEach((button) => {
        button.addEventListener('click', () => {
          if (!postContentInput) return;
          const start = postContentInput.selectionStart || 0;
          const end = postContentInput.selectionEnd || 0;
          const currentValue = postContentInput.value;
          const selectedText = currentValue.slice(start, end) || '텍스트';

          const insertPrefix = button.getAttribute('data-md-insert');
          const wrapToken = button.getAttribute('data-md-wrap');
          const blockText = button.getAttribute('data-md-block');

          let replacement = '';
          if (insertPrefix) {
            replacement = insertPrefix + selectedText;
          } else if (wrapToken) {
            replacement = wrapToken + selectedText + wrapToken;
          } else if (blockText) {
            replacement = blockText.replace(/\\n/g, '\n');
          }

          postContentInput.value =
            currentValue.slice(0, start) + replacement + currentValue.slice(end);
          postContentInput.focus();
          updateLivePreview();
        });
      });

      function populateEditorForPost(post) {
        const isEditing = Boolean(post);
        if (formHeading) {
          formHeading.textContent = isEditing
            ? `포스트 수정: ${post.title}`
            : '새 블로그 포스트 작성';
        }
        if (postIdInput) postIdInput.value = isEditing ? String(post.id) : '';
        if (postTitleInput) postTitleInput.value = isEditing ? post.title : '';
        if (postSlugInput) postSlugInput.value = isEditing ? post.slug : '';
        if (postSummaryInput) postSummaryInput.value = isEditing ? post.summary || '' : '';
        if (postTagsInput) postTagsInput.value = isEditing ? (post.tags || []).join(', ') : '';
        if (postPublishedInput) {
          postPublishedInput.checked = isEditing ? Boolean(post.is_published) : true;
        }
        if (postContentInput) postContentInput.value = isEditing ? post.content_md || '' : '';

        slugManuallyEdited = isEditing;
        updateLivePreview();
      }

      if (newPostBtn) {
        newPostBtn.addEventListener('click', () => populateEditorForPost(null));
      }

      async function handleDeletePost(post) {
        const confirmed = await showConfirmPopup(
          '게시물 삭제 확인',
          `정말로 '${post.title}' 게시물을 삭제하시겠습니까? 삭제된 게시물은 복구할 수 없습니다.`,
          { confirmText: '삭제', isDanger: true }
        );
        if (!confirmed) return;

        const response = await fetch(`/api/admin/posts?id=${post.id}`, { method: 'DELETE' });
        if (response.ok) {
          await loadAdminPosts();
          if (postIdInput && postIdInput.value === String(post.id)) {
            populateEditorForPost(null);
          }
          await showAlertPopup('삭제 완료', `'${post.title}' 게시물이 삭제되었습니다.`);
        } else {
          await showAlertPopup('오류', '게시물 삭제 중 오류가 발생했습니다.');
        }
      }

      function createAdminPostRowElement(post) {
        const row = createEl(
          'div',
          'p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5'
        );
        const info = createEl('div', 'space-y-1 min-w-0');
        const topLine = createEl('div', 'flex items-center gap-2.5');

        const statusBadgeClass = post.is_published
          ? 'font-mono text-xs px-2 py-0.5 rounded border border-light-accent dark:border-dark-accent text-light-accent dark:text-dark-accent'
          : 'font-mono text-xs px-2 py-0.5 rounded border border-light-border dark:border-dark-border text-light-secondary dark:text-dark-secondary';
        const statusBadge = createEl(
          'span',
          statusBadgeClass,
          post.is_published ? 'Published' : 'Draft'
        );

        const titleEl = createEl(
          'span',
          'text-base font-bold text-light-primary dark:text-dark-primary truncate',
          post.title
        );
        topLine.append(statusBadge, titleEl);

        const createdDate = (post.created_at || '').slice(0, 10);
        const metaEl = createEl(
          'div',
          'font-mono text-sm text-light-secondary dark:text-dark-secondary',
          `/blog/${post.slug} · ${createdDate}`
        );

        info.append(topLine, metaEl);

        const editBtn = createEl(
          'button',
          'font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border hover:border-light-accent dark:hover:border-dark-accent',
          'Edit'
        );
        editBtn.type = 'button';
        editBtn.addEventListener('click', () => populateEditorForPost(post));

        const deleteBtn = createEl(
          'button',
          'font-mono text-sm px-3 py-1.5 rounded border border-light-border dark:border-dark-border text-red-600 dark:text-red-400 hover:border-red-500',
          'Delete'
        );
        deleteBtn.type = 'button';
        deleteBtn.addEventListener('click', () => handleDeletePost(post));

        const actions = createEl('div', 'flex items-center gap-2.5 shrink-0');
        actions.append(editBtn, deleteBtn);

        row.append(info, actions);
        return row;
      }

      function renderAdminPostsList() {
        if (!adminPostsList) return;
        if (adminPosts.length === 0) {
          adminPostsList.innerHTML =
            '<div class="p-5 text-sm font-mono text-light-secondary dark:text-dark-secondary">작성된 포스트가 없습니다.</div>';
          return;
        }
        adminPostsList.innerHTML = '';
        adminPosts.forEach((post) => {
          adminPostsList.appendChild(createAdminPostRowElement(post));
        });
      }

      async function loadAdminPosts() {
        const response = await fetch('/api/admin/posts');
        if (!response.ok) return;
        const data = await response.json();
        adminPosts = Array.isArray(data.posts) ? data.posts : [];
        renderAdminPostsList();
      }

      if (blogForm) {
        blogForm.addEventListener('submit', async (event) => {
          event.preventDefault();
          const isEditing = Boolean(postIdInput && postIdInput.value);
          const titleVal = postTitleInput ? postTitleInput.value.trim() : '';

          const confirmed = await showConfirmPopup(
            isEditing ? '게시물 수정 확인' : '새 게시물 등록 확인',
            isEditing
              ? `'${titleVal}' 게시물의 수정 사항을 저장하시겠습니까?`
              : `'${titleVal}' 게시물을 등록하시겠습니까?`,
            { confirmText: isEditing ? '수정 저장' : '등록' }
          );
          if (!confirmed) return;

          const tags = (postTagsInput ? postTagsInput.value : '')
            .split(',')
            .map((tag) => tag.trim())
            .filter(Boolean);

          const payload = {
            id: isEditing ? Number(postIdInput.value) : undefined,
            title: titleVal,
            slug: postSlugInput ? postSlugInput.value : '',
            summary: postSummaryInput ? postSummaryInput.value : '',
            tags,
            is_published: postPublishedInput ? postPublishedInput.checked : true,
            content_md: postContentInput ? postContentInput.value : '',
          };

          const response = await fetch('/api/admin/posts', {
            method: payload.id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (response.ok) {
            const data = await response.json();
            if (blogSaveStatus) {
              blogSaveStatus.textContent = `저장 완료 (/blog/${data.post.slug})`;
              blogSaveStatus.className =
                'font-mono text-sm text-light-accent dark:text-dark-accent';
            }
            await loadAdminPosts();
            populateEditorForPost(data.post);
            await showAlertPopup(
              isEditing ? '수정 완료' : '등록 완료',
              `'${data.post.title}' 게시물이 성공적으로 저장되었습니다.`
            );
          } else {
            const err = await response.json().catch(() => ({}));
            if (blogSaveStatus) {
              blogSaveStatus.textContent = err.error || '저장 중 오류가 발생했습니다.';
              blogSaveStatus.className = 'font-mono text-sm text-red-600 dark:text-red-400';
            }
            await showAlertPopup('오류', err.error || '게시물 저장 중 오류가 발생했습니다.');
          }
        });
      }

      loadGitHubRepos(false);
      loadAdminPosts();
    })();
  </script>
</BaseLayout>
